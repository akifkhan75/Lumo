# Lumo NestJS API Environment Variables
# Copy this file to .env and adjust values for your local environment

# Database connection string (PostgreSQL)
# Lumo default runs on host port 5434
DATABASE_URL="postgresql://lumo:lumo_password@localhost:5434/lumo_db?schema=public"

# HTTP server port for NestJS
API_PORT=3005

# JWT authentication secret. REQUIRED — the API refuses to start without it,
# and rejects this example value. Generate a real one:
#   openssl rand -base64 48
JWT_SECRET=""

# Key that personal data (contact phone numbers and emails, blood type, allergies)
# is encrypted with at rest. REQUIRED — the API refuses to start without it.
# base64 of 32 random bytes:   openssl rand -base64 32
# LOSING IT LOSES THE DATA. Back it up separately from the database it protects.
DATA_ENCRYPTION_KEY=""
# Optional. Names the key (stored with every value); needed only for rotation.
# DATA_ENCRYPTION_KEY_ID="k1"
# Optional. Retired keys that can still decrypt: "id:base64,id:base64".
# DATA_ENCRYPTION_KEYS_PREVIOUS=""

# Comma-separated browser origins allowed to call the API. The mobile app is
# not subject to CORS, so this is empty until the Phase 1 journey page exists.
# CORS_ORIGINS="https://journey.lumo.example"

# Google Gemini API key for emergency assistance & safety tips
API_KEY="your-gemini-api-key-here"
