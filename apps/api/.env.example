# Lumo NestJS API Environment Variables
# Copy this file to .env and adjust values for your local environment

# Database connection string (PostgreSQL)
# Lumo default runs on host port 5434
DATABASE_URL="postgresql://lumo:lumo_password@localhost:5434/lumo_db?schema=public"

# HTTP server port for NestJS
API_PORT=3005

# JWT authentication secret. REQUIRED — the API refuses to start without it,
# and rejects this example value. Generate a real one:
#   openssl rand -base64 48
JWT_SECRET=""

# Key that personal data (contact phone numbers and emails, blood type, allergies)
# is encrypted with at rest. REQUIRED — the API refuses to start without it.
# base64 of 32 random bytes:   openssl rand -base64 32
# LOSING IT LOSES THE DATA. Back it up separately from the database it protects.
DATA_ENCRYPTION_KEY=""
# Optional. Names the key (stored with every value); needed only for rotation.
# DATA_ENCRYPTION_KEY_ID="k1"
# Optional. Retired keys that can still decrypt: "id:base64,id:base64".
# DATA_ENCRYPTION_KEYS_PREVIOUS=""

# Markets Lumo serves: comma-separated profile ids ("PK,US"). Blank means none, which
# is allowed. In production the API REFUSES TO START if a listed market's profile is
# incomplete or its legal review is not approved; both shipped profiles are drafts, so
# do not list them in production. Outside production a draft may be listed, and is
# marked internal-testing.
# ENABLED_REGIONS="PK,US"

# Comma-separated browser origins allowed to call the API. The mobile app is
# not subject to CORS, so this is empty until the Phase 1 journey page exists.
# CORS_ORIGINS="https://journey.lumo.example"

# Google Gemini API key for emergency assistance & safety tips
API_KEY="your-gemini-api-key-here"

# --- Notifications (milestone 1.7a) -----------------------------------------------------
# SMS through Twilio. ALL OPTIONAL: with any missing, the API still boots and every SMS
# attempt is recorded "not attempted — provider not configured". It never pretends to send.
# Never run against real Twilio yet (no account). Needs US A2P 10DLC registration to reach US numbers.
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# One of these two senders:
# TWILIO_MESSAGING_SERVICE_SID=""
# TWILIO_FROM="+15005550006"
# Voice calls need a CALLER NUMBER of their own (a messaging service cannot place a call):
# TWILIO_VOICE_FROM="+15005550006"
# Where Twilio can reach THIS API. The webhook signature is computed over this exact URL, so it
# is read from here, never from the request's Host header.
# PUBLIC_API_URL="https://api.lumo.example"
#
# The send queue (pg-boss) lives in the same Postgres, in the schema below, and is created on
# boot (the database user needs CREATE on the database). "off" boots the API with no worker:
# nothing can be planned or sent.
# NOTIFICATIONS_QUEUE="on"
# NOTIFICATIONS_QUEUE_SCHEMA="pgboss"
